# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/

# Turbo cache
.turbo/

# TypeScript incremental build info — must never be committed.
# Nixpacks mounts a build-cache volume at this path; a committed file
# there clashes with the directory mount and crashes the container.
*.tsbuildinfo

# Environment — NEVER commit these
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
.next-stale-*/
