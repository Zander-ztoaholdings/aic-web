# ── Database ──────────────────────────────────────────────────────────────────
# A SINGLE connection string — this is what lib/db actually reads. Split
# POSTGRES_USER/HOST/PORT/DB variables are NOT read and will not connect.
# In Docker/Coolify the host must be the database SERVICE NAME, never localhost.
DATABASE_URL=postgres://user:password@localhost:5432/aic

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ── Notion CMS ────────────────────────────────────────────────────────────────
# Each database must be SHARED with the "AIC-CMS" integration in Notion
# (open the database -> ... -> Connections -> AIC-CMS), otherwise the API
# answers "Could not find database with ID ...".
NOTION_API_KEY=

# Feeds /articles. Created 2 Sep 2026.
NOTION_ARTICLES_DATABASE_ID=a2155af1-0e37-4b6c-a934-bb5bad3abd3d

# Feeds the Policy Updates section of /governance-hub. Created 2 Sep 2026.
NOTION_POLICY_UPDATES_DATABASE_ID=f8a98984-d186-4359-bae8-aa434721fdef

# Optional. Contact submissions are stored in Postgres regardless; this only
# mirrors them into Notion for triage. The previous value pointed at a page that
# had been deleted, which is why nothing was arriving.
NOTION_CONTACT_DATABASE_ID=

# ── Contact form notifications ────────────────────────────────────────────────
# Optional but strongly recommended: without it, an enquiry sits in the database
# until someone thinks to look. With it, a human is told.
# Resend is called over its REST API — no npm dependency.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=zander@ztoaholdings.com
CONTACT_NOTIFY_FROM=website@aiccertified.cloud

# Salt for hashing submitter IPs. An IP is personal information under POPIA, so
# it is never stored raw. Any long random string; changing it only resets
# repeat-abuse detection.
CONTACT_IP_SALT=

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ── Platform App URL (where aic-platform is hosted) ──────────────────────────
NEXT_PUBLIC_PLATFORM_URL=https://app.aiccertified.cloud
